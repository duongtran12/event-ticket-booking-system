# Copy this file to .env and replace every placeholder before starting Docker.
# Never commit the resulting .env file.

MYSQL_ROOT_PASSWORD=replace-with-a-strong-database-password
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes

# Keep true only while adopting Flyway for an existing database. Set false after
# flyway_schema_history has been created successfully.
FLYWAY_BASELINE_ON_MIGRATE=true

# Optional one-time admin bootstrap. Use a unique password with at least 12 characters.
# Leave both blank when an admin account already exists.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional integrations. Leave blank when the integration is not used.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8081/api/bookings/payment-callback
FRONTEND_URL=http://localhost:3000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
CHAT_PROVIDER=gemini
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@eventticket.local
